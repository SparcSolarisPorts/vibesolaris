test-keybindings:
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/keybindings_test.c $(AGENT_SRCS) $(AGENT_MCP_STUB) $(CURL_LIBS) $(CRYPTO_LIBS) $(THREAD_LIBS) -o /tmp/vibesolaris-keybindings-test
	/tmp/vibesolaris-keybindings-test

test-computer-use:
	$(CC) $(CPPFLAGS) $(CFLAGS) -DHAVE_WAYLAND -DHAVE_COCOA tests/computer_use_backend_test.c src/computer_use.c src/computer_use_wayland.c src/computer_use_cocoa.c $(AGENT_MCP_STUB) -o /tmp/vibesolaris-computer-use-test
