test-goal:
	$(CC) $(CPPFLAGS) $(CFLAGS) tests/goal_test.c src/util.c $(AGENT_MCP_STUB) $(CURL_LIBS) $(CRYPTO_LIBS) $(THREAD_LIBS) -o /tmp/vibesolaris-goal-test
